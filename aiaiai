SYSTEM_PROMPT = """You are aiaiai, a terminal assistant. The user describes what they want to do \
and you reply with the single shell command that does it.

Rules:
- Reply with a JSON object and nothing else: {"command": "...", "explanation": "..."}
- "command" is one runnable command line for the user's shell. Chain with && or ; or a one-line \
loop if needed, but never return multiple lines and never wrap it in a code fence.
- "explanation" is at most two short sentences saying what the command does and calling out \
anything destructive. No markdown.
- Prefer portable, standard tools already present on the system. Use the real file and directory \
names from the context when they are given.
- If the request is impossible or too vague to turn into a command, set "command" to "" and \
explain why in "explanation".
"""


# ---------------------------------------------------------------- output utils

def _color(code: str) -> str:
    if os.environ.get("NO_COLOR") or not sys.stderr.isatty():
        return ""
    return code


BOLD, DIM, RED, GREEN, YELLOW, RESET = (
    _color("\033[1m"), _color("\033[2m"), _color("\033[31m"),
    _color("\033[32m"), _color("\033[33m"), _color("\033[0m"),
)


def die(msg: str, code: int = 1):
    print(f"{RED}aiaiai:{RESET} {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg: str):
    print(msg, file=sys.stderr)


# ---------------------------------------------------------------------- config

def load_config(path: str | None) -> dict:
    cfg = dict(DEFAULTS)
    path = path or CONFIG_PATH
    cfg["_config_path"] = path
    cfg["_configured"] = os.path.exists(path)
    if os.path.exists(path):
        try:
            import tomllib
            with open(path, "rb") as fh:
                cfg.update(tomllib.load(fh))
        except Exception as exc:  # noqa: BLE001
            die(f"could not read config {path}: {exc}")

    env = {
        "base_url": "AIAIAI_BASE_URL",
        "model": "AIAIAI_MODEL",
        "api_key": "AIAIAI_API_KEY",
        "mode": "AIAIAI_MODE",
        "shell": "AIAIAI_SHELL",
    }
    for key, var in env.items():
        if os.environ.get(var):
            cfg[key] = os.environ[var]
    return cfg


def save_config(path: str, cfg: dict):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w") as fh:
        fh.write(render_config(cfg))
    os.chmod(path, 0o600)  # may contain an API key
    note(f"{GREEN}wrote{RESET} {path}")


def write_example_config(path: str):
    if os.path.exists(path):
        die(f"{path} already exists, leaving it alone (try: {PROG} --setup)")
    save_config(path, dict(DEFAULTS))


# --------------------------------------------------------------------- context

def user_shell(cfg: dict) -> str:
    sh = cfg.get("shell", "auto")
    if sh and sh != "auto":
        return sh
    return os.environ.get("SHELL") or shutil.which("bash") or "/bin/sh"


def os_description() -> str:
    """A name the model will recognise: "Ubuntu 24.04.1 LTS", "macOS 15.1", ..."""
    system = platform.system()
    if system == "Linux":
        try:
            fields = {}
            with open("/etc/os-release") as fh:
                for line in fh:
                    if "=" in line:
                        key, _, value = line.partition("=")
                        fields[key.strip()] = value.strip().strip('"')
            name = fields.get("PRETTY_NAME") or fields.get("NAME")
            if name:
                return f"{name} (Linux {platform.release()}, GNU userland)"
        except OSError:
            pass
        return f"Linux {platform.release()} (GNU userland)"
    if system == "Darwin":
        return f"macOS {platform.mac_ver()[0] or platform.release()} (BSD userland, not GNU)"
    return f"{system} {platform.release()}"


# Tools worth telling the model about: their presence changes the right answer
# (rg vs grep, fd vs find, gdate vs date). Cheap to probe, all PATH lookups.
PROBE_TOOLS = [
    "rg", "ag", "fd", "fdfind", "jq", "yq", "gawk", "sed", "gsed", "find", "xargs",
    "rsync", "curl", "wget", "tar", "zstd", "7z", "unzip",
    "git", "gh", "docker", "podman", "kubectl", "helm", "systemctl", "journalctl",
    "ffmpeg", "imagemagick", "magick", "convert", "exiftool", "pdftk", "qpdf",
    "python3", "node", "npm", "pnpm", "uv", "pipx", "cargo", "go",
    "apt", "dnf", "pacman", "brew", "snap", "flatpak",
    "tmux", "fzf", "bat", "eza", "exa", "tree", "ncdu", "duf", "parallel",
]


def available_tools(cfg: dict) -> list[str]:
    extra = cfg.get("extra_tools") or []
    seen, found = set(), []
    for name in list(PROBE_TOOLS) + list(extra):
        if name in seen:
            continue
        seen.add(name)
        if shutil.which(name):
            found.append(name)
    return found


def gather_context(cfg: dict, extra_paths: list[str]) -> str:
    cwd = os.getcwd()
    lines = [
        f"cwd: {cwd}",
        f"os: {os_description()}",
        f"shell: {os.path.basename(user_shell(cfg))}",
    ]
    if cfg.get("tools", True):
        tools = available_tools(cfg)
        if tools:
            lines.append(f"tools on PATH: {', '.join(tools)}")
            lines.append("only use tools from that list, or ones every unix has.")
    if not cfg.get("context", True):
        return "\n".join(lines)

    limit = int(cfg.get("max_context_entries", 40))
    for target in [cwd] + extra_paths:
        try:
            entries = sorted(os.listdir(target))
        except OSError as exc:
            lines.append(f"contents of {target}: unavailable ({exc.strerror})")
            continue
        shown = []
        for name in entries[:limit]:
            full = os.path.join(target, name)
            shown.append(name + ("/" if os.path.isdir(full) else ""))
        more = f" (+{len(entries) - limit} more)" if len(entries) > limit else ""
        label = "contents of cwd" if target == cwd else f"contents of {target}"
        lines.append(f"{label}: {', '.join(shown) if shown else '(empty)'}{more}")
    return "\n".join(lines)


def read_piped_stdin() -> str:
    """Piped input, if any is actually waiting. Never blocks on an idle pipe."""
    if sys.stdin is None or sys.stdin.isatty():
        return ""
    try:
        ready, _, _ = select.select([sys.stdin], [], [], 0.05)
        if not ready:
            return ""
        return sys.stdin.read(100_000).strip()
    except (OSError, ValueError):
        return ""


def referenced_paths(question: str) -> list[str]:
    """Absolute paths mentioned in the question that actually exist as directories."""
    found = []
    for token in re.findall(r"(?:^|\s)(~?/[^\s'\"]+)", question):
        path = os.path.expanduser(token.rstrip(".,;:"))
        if os.path.isdir(path) and path != os.getcwd() and path not in found:
            found.append(path)
    return found[:3]



