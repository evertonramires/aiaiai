# ------------------------------------------------------------------ output

def _supports_color() -> bool:
    if os.environ.get("NO_COLOR") or not sys.stderr.isatty():
        return False
    if IS_WINDOWS:
        try:  # enable ANSI on conhost; Windows Terminal and pwsh have it already
            import ctypes
            kernel32 = ctypes.windll.kernel32
            kernel32.SetConsoleMode(kernel32.GetStdHandle(-12), 7)
        except Exception:  # noqa: BLE001
            return bool(os.environ.get("WT_SESSION"))
    return True


COLOR = _supports_color()
BOLD, DIM, RED, GREEN, YELLOW, RESET = (
    ("\033[1m", "\033[2m", "\033[31m", "\033[32m", "\033[33m", "\033[0m")
    if COLOR else ("", "", "", "", "", "")
)


def note(msg: str = ""):
    print(msg, file=sys.stderr)


def die(msg: str, code: int = 1):
    note(f"{RED}aiaiai:{RESET} {msg}")
    sys.exit(code)


class Thinking:
    """A spinner on stderr, so a slow model never looks like a hung program."""

    FRAMES = "-\\|/" if IS_WINDOWS else "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, label: str, timeout: float):
        self.label = label
        self.timeout = timeout
        self.enabled = sys.stderr.isatty() and not os.environ.get("AIAIAI_NO_SPINNER")
        self._stop = threading.Event()
        self._thread = None

    def _spin(self):
        start = time.monotonic()
        for frame in itertools.cycle(self.FRAMES):
            if self._stop.wait(0.12):
                return
            elapsed = time.monotonic() - start
            tail = ""
            if elapsed > 20:
                tail = f" {DIM}(ctrl-c to give up, {self.timeout - elapsed:.0f}s left){RESET}"
            sys.stderr.write(f"\r{DIM}{frame} {self.label} {elapsed:.0f}s{RESET}{tail}\033[K")
            sys.stderr.flush()

    def __enter__(self):
        if self.enabled:
            self._thread = threading.Thread(target=self._spin, daemon=True)
            self._thread.start()
        return self

    def __exit__(self, *exc):
        if self._thread:
            self._stop.set()
            self._thread.join(timeout=1)
            sys.stderr.write("\r\033[K")
            sys.stderr.flush()
        return False


# ------------------------------------------------------------------- config

def toml_str(value) -> str:
    """Quote a value for TOML. Only the types this config actually holds."""
    if isinstance(value, list):
        return "[" + ", ".join(toml_str(v) for v in value) + "]"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    escaped = str(value).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def render_config(cfg: dict) -> str:
    return CONFIG_TEMPLATE.format(**{k: toml_str(cfg.get(k, v)) for k, v in DEFAULTS.items()})


def load_config(path: str | None) -> dict:
    import tomllib

    cfg = dict(DEFAULTS)
    path = path or CONFIG_PATH
    cfg["_path"] = path
    cfg["_configured"] = os.path.exists(path)
    cfg["_model_set"] = False
    if cfg["_configured"]:
        try:
            with open(path, "rb") as fh:
                data = tomllib.load(fh)
            cfg.update(data)
            cfg["_model_set"] = "model" in data
        except (OSError, ValueError) as exc:
            die(f"could not read config {path}: {exc}\n  fix it, or start over with "
                f"'{PROG} --setup'")

    for key, var in (("base_url", "AIAIAI_BASE_URL"), ("model", "AIAIAI_MODEL"),
                     ("api_key", "AIAIAI_API_KEY"), ("mode", "AIAIAI_MODE"),
                     ("shell", "AIAIAI_SHELL"), ("provider", "AIAIAI_PROVIDER"),
                     ("claude_bin", "AIAIAI_CLAUDE_BIN")):
        if os.environ.get(var):
            cfg[key] = os.environ[var]
    cfg["_model_set"] = cfg["_model_set"] or bool(os.environ.get("AIAIAI_MODEL"))
    return cfg


def normalize_provider(name: str) -> str:
    name = str(name or "openai").strip().lower().replace("_", "-")
    if name in ("claude", "claude-code", "claudecode"):
        return "claude-code"
    if name in ("openai", "openai-compatible"):
        return "openai"
    die(f"unknown provider {name!r} - expected one of {', '.join(PROVIDERS)}")
    return name


def settle_provider(cfg: dict):
    """Normalise the provider, and when nobody picked a model give it the
    provider's own default: each side rejects the other's model names."""
    cfg["provider"] = normalize_provider(cfg.get("provider"))
    if not cfg.get("_model_set"):
        cfg["model"] = CLAUDE_DEFAULT_MODEL if cfg["provider"] == "claude-code" \
            else DEFAULTS["model"]


def save_config(path: str, cfg: dict):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w") as fh:
        fh.write(render_config(cfg))
    if not IS_WINDOWS:
        os.chmod(path, 0o600)  # it can hold an API key
    note(f"{GREEN}wrote{RESET} {path}")


# ----------------------------------------------------------------- platform

def user_shell(cfg: dict) -> str:
    configured = cfg.get("shell", "auto")
    if configured and configured != "auto":
        return shutil.which(configured) or configured
    if IS_WINDOWS:
        return shutil.which("pwsh") or shutil.which("powershell") or "powershell.exe"
    return os.environ.get("SHELL") or shutil.which("bash") or "/bin/sh"


def is_powershell(shell: str) -> bool:
    return base_name(shell).lower().removesuffix(".exe") in ("pwsh", "powershell")


def shell_argv(shell: str, command: str) -> list[str]:
    if is_powershell(shell):
        return [shell, "-NoProfile", "-Command", command]
    return [shell, "-c", command]


def shell_name(cfg: dict) -> str:
    return base_name(user_shell(cfg)).removesuffix(".exe")


def os_description() -> str:
    """A name the model recognises: "Ubuntu 24.04.1 LTS", "macOS 15.1", ..."""
    system = platform.system()
    if system == "Linux":
        try:
            fields = {}
            with open("/etc/os-release") as fh:
                for line in fh:
                    key, _, value = line.partition("=")
                    fields[key.strip()] = value.strip().strip('"')
            name = fields.get("PRETTY_NAME") or fields.get("NAME")
            if name:
                return f"{name} (Linux {platform.release()}, GNU userland)"
        except OSError:
            pass
        return f"Linux {platform.release()} (GNU userland)"
    if system == "Darwin":
        return f"macOS {platform.mac_ver()[0] or platform.release()} (BSD userland, not GNU)"
    if system == "Windows":
        release, build = platform.win32_ver()[:2]
        return f"Windows {release} (build {build})"
    return f"{system} {platform.release()}"


# Tools whose presence changes the right answer (rg vs grep, apt vs dnf).
# A bounded PATH probe, not an inventory of installed software.
PROBE_TOOLS_UNIX = [
    "rg", "fd", "fdfind", "jq", "yq", "gawk", "rsync",
    "curl", "wget", "zstd", "7z", "unzip", "git", "gh", "docker", "podman",
    "kubectl", "helm", "systemctl", "journalctl", "ffmpeg", "magick", "convert",
    "exiftool", "qpdf", "python3", "node", "npm", "pnpm", "uv", "cargo", "go",
    "apt", "dnf", "pacman", "zypper", "apk", "brew", "snap", "flatpak",
    "tmux", "fzf", "bat", "eza", "tree", "ncdu", "parallel",
]
PROBE_TOOLS_WINDOWS = [
    "winget", "choco", "scoop", "git", "gh", "docker", "kubectl", "python", "node",
    "npm", "pnpm", "cargo", "go", "curl", "tar", "robocopy", "7z", "ffmpeg", "rg", "fd", "jq",
]


def available_tools(cfg: dict) -> list[str]:
    probe = PROBE_TOOLS_WINDOWS if IS_WINDOWS else PROBE_TOOLS_UNIX
    seen, found = set(), []
    for name in probe + list(cfg.get("extra_tools") or []):
        if name not in seen:
            seen.add(name)
            if shutil.which(name):
                found.append(name)
    return found


# ------------------------------------------------------------------ context

def referenced_paths(question: str) -> list[str]:
    """Absolute paths named in the question that exist as directories."""
    pattern = r"(?:^|\s)([A-Za-z]:\\[^\s'\"]+|~?/[^\s'\"]+)" if IS_WINDOWS \
        else r"(?:^|\s)(~?/[^\s'\"]+)"
    found = []
    for token in re.findall(pattern, question):
        path = os.path.expanduser(token.rstrip(".,;:"))
        if os.path.isdir(path) and path != os.getcwd() and path not in found:
            found.append(path)
    return found[:3]


def read_piped_stdin() -> str:
    """Piped input, if any is waiting. Never blocks on an idle pipe."""
    if sys.stdin is None or sys.stdin.isatty():
        return ""
    if IS_WINDOWS:  # select() only works on sockets here, so time-box a reader
        box = []
        reader = threading.Thread(target=lambda: box.append(sys.stdin.read(100_000)),
                                  daemon=True)
        reader.start()
        reader.join(timeout=0.5)
        return box[0].strip() if box else ""
    import select
    try:
        ready, _, _ = select.select([sys.stdin], [], [], 0.05)
        return sys.stdin.read(100_000).strip() if ready else ""
    except (OSError, ValueError):
        return ""


def gather_context(cfg: dict, extra_paths: list[str]) -> str:
    cwd = os.getcwd()
    lines = [
        f"cwd: {cwd}",
        f"os: {os_description()}",
        f"shell: {shell_name(cfg)}",
    ]
    if cfg.get("tools", True):
        tools = available_tools(cfg)
        if tools:
            lines.append(f"tools on PATH: {', '.join(tools)}")
            lines.append("Only use tools from that list, or ones every system has.")
    if not cfg.get("context", True):
        return "\n".join(lines)

    limit = int(cfg.get("max_context_entries", 40))
    for target in [cwd] + extra_paths:
        try:
            entries = sorted(os.listdir(target))
        except OSError as exc:
            lines.append(f"contents of {target}: unavailable ({exc.strerror})")
            continue
        shown = [name + ("/" if os.path.isdir(os.path.join(target, name)) else "")
                 for name in entries[:limit]]
        more = f" (+{len(entries) - limit} more)" if len(entries) > limit else ""
        label = "contents of cwd" if target == cwd else f"contents of {target}"
        lines.append(f"{label}: {', '.join(shown) if shown else '(empty)'}{more}")
    return "\n".join(lines)


# ---------------------------------------------------------------------- api

def endpoint(base_url: str) -> str:
    base = base_url.rstrip("/")
    if not base.endswith("/v1"):
        base += "/v1"
    return base + "/chat/completions"


def post(cfg: dict, payload: dict, timeout: float) -> dict:
    req = urllib.request.Request(
        endpoint(cfg["base_url"]),
        data=json.dumps(payload).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {cfg.get('api_key') or 'not-required'}",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode())


class ClaudeCodeError(Exception):
    """Claude Code ran but could not answer; the message says why."""


def claude_bin(cfg: dict) -> str:
    configured = cfg.get("claude_bin") or "claude"
    return shutil.which(configured) or configured


def ask_claude_code(cfg: dict, system: str, user: str, timeout: float) -> str:
    """One non-interactive turn of the Claude Code CLI, with every tool off:
    it only writes the answer, aiaiai decides what runs."""
    # The system prompt goes through a file, since multi-line arguments do not
    # survive every Windows launcher intact.
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False,
                                     encoding="utf-8") as fh:
        fh.write(system)
        prompt_file = fh.name
    argv = [claude_bin(cfg), "-p", "--output-format", "json", "--tools", "",
            "--no-session-persistence", "--strict-mcp-config",
            "--system-prompt-file", prompt_file]
    if cfg.get("model"):
        argv += ["--model", str(cfg["model"])]
    try:
        proc = subprocess.run(argv, input=user, capture_output=True, text=True,
                              encoding="utf-8", errors="replace", timeout=timeout)
    except subprocess.TimeoutExpired:
        raise TimeoutError from None
    except OSError as exc:
        raise ClaudeCodeError(
            f"could not start Claude Code ({argv[0]}): {exc.strerror or exc}\n"
            f"  install it from https://code.claude.com/docs, or set claude_bin "
            f"in {cfg.get('_path', CONFIG_PATH)}") from None
    finally:
        try:
            os.unlink(prompt_file)
        except OSError:
            pass

    try:
        body = json.loads(proc.stdout)
    except json.JSONDecodeError:
        body = None
    if not isinstance(body, dict):
        detail = (proc.stderr or proc.stdout or "").strip()[:300] or f"exit code {proc.returncode}"
        hint = ("this Claude Code is too old for aiaiai - update it with 'claude update'"
                if "unknown option" in detail
                else f"does '{argv[0]} -p hello' work? You may need to log in first.")
        raise ClaudeCodeError(f"Claude Code failed: {detail}\n  {hint}")
    if body.get("is_error") or proc.returncode != 0:
        detail = str(body.get("result") or body.get("subtype") or "unknown error")[:300]
        raise ClaudeCodeError(f"Claude Code answered with an error: {detail}")
    return str(body.get("result") or "")


def ask(cfg: dict, question: str, context: str) -> dict:
    timeout = float(cfg.get("timeout", 90))
    system = SYSTEM_PROMPT.format(
        shell_name=shell_name(cfg),
        syntax_hint=" using PowerShell cmdlets and syntax, not bash"
                    if is_powershell(user_shell(cfg)) else "",
    )
    user = f"Context:\n{context}\n\nRequest: {question}"

    if cfg.get("provider") == "claude-code":
        try:
            with Thinking(f"asking Claude Code ({cfg.get('model') or 'default model'})", timeout):
                content = ask_claude_code(cfg, system, user, timeout)
        except ClaudeCodeError as exc:
            die(str(exc))
        except TimeoutError:
            die(f"Claude Code did not answer within {timeout:.0f}s.\n"
                f"  a bigger timeout may help: raise it in {cfg.get('_path', CONFIG_PATH)},\n"
                f"  or try a faster model such as haiku.")
        except KeyboardInterrupt:
            die("cancelled", 130)
        return parse_answer(content)

    payload = {
        "model": cfg["model"],
        "temperature": float(cfg.get("temperature", 0.2)),
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
    }
    try:
        with Thinking(f"asking {cfg['model']}", timeout):
            body = post(cfg, payload, timeout)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")[:300]
        hint = {401: "  check your api key", 403: "  check your api key",
                404: "  check the model name and the url"}.get(exc.code, "")
        die(f"the server answered HTTP {exc.code}: {detail}" + (f"\n{hint}" if hint else ""))
    except (TimeoutError, urllib.error.URLError) as exc:
        reason = getattr(exc, "reason", exc)
        if isinstance(exc, TimeoutError) or isinstance(reason, TimeoutError) \
                or "timed out" in str(reason):
            die(f"{cfg['model']} did not answer within {timeout:.0f}s.\n"
                f"  a bigger timeout may help: raise it in {cfg.get('_path', CONFIG_PATH)},\n"
                f"  or try a smaller/faster model.")
        if not cfg.get("_configured"):
            die(f"cannot reach {cfg['base_url']}: {reason}\n"
                f"  nothing is configured yet - run '{PROG} --setup'")
        die(f"cannot reach {cfg['base_url']}: {reason}\n  is the server running?")
    except KeyboardInterrupt:
        die("cancelled", 130)

    try:
        content = body["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        die(f"unexpected response from the server: {json.dumps(body)[:300]}")
    return parse_answer(content)


def parse_answer(content: str) -> dict:
    text = (content or "").strip()
    text = re.sub(r"^<think>.*?</think>", "", text, flags=re.S).strip()
    fence = re.search(r"```(?:json|sh|bash|powershell|ps1)?\s*(.*?)```", text, flags=re.S)
    if fence:
        text = fence.group(1).strip()

    obj = None
    try:
        obj = json.loads(text)
    except json.JSONDecodeError:
        brace = re.search(r"\{.*\}", text, flags=re.S)
        if brace:
            try:
                obj = json.loads(brace.group(0))
            except json.JSONDecodeError:
                obj = None

    if isinstance(obj, dict):
        command = str(obj.get("command") or "").strip()
        explanation = str(obj.get("explanation") or "").strip()
    else:  # model ignored the format: first non-empty line is the command
        lines = [ln for ln in text.splitlines() if ln.strip()]
        command = lines[0].strip() if lines else ""
        explanation = " ".join(ln.strip() for ln in lines[1:]).strip()

    command = command.strip("`").strip()
    if command.startswith("$ "):
        command = command[2:]
    return {"command": command, "explanation": explanation}


# ---------------------------------------------------------------- execution

def danger(command: str) -> str | None:
    for pattern, why in DANGEROUS:
        if re.search(pattern, command, flags=re.I):
            return why
    return None


def edit_command(command: str) -> str | None:
    try:
        import readline
        readline.set_startup_hook(lambda: readline.insert_text(command))
        try:
            return input("> ").strip() or None
        finally:
            readline.set_startup_hook()
    except ImportError:  # no readline on this platform: plain retype
        note(f"{DIM}retype the command (empty cancels){RESET}")
        try:
            return input("> ").strip() or None
        except (EOFError, KeyboardInterrupt):
            note()
            return None
    except (EOFError, KeyboardInterrupt):
        note()
        return None


def confirm_command(command: str, risk: str | None) -> str | None:
    """The command to run, or None to abort."""
    if not sys.stdin.isatty():
        note(f"{YELLOW}not a terminal, so not running anything without confirmation{RESET}")
        return None
    while True:
        hint = f"{RED}[{risk}]{RESET} " if risk else ""
        try:
            answer = input(f"{hint}run it? [y/N/e(dit)] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            note()
            return None
        if answer in ("y", "yes"):
            return command
        if answer in ("", "n", "no", "q"):
            return None
        if answer in ("e", "edit"):
            return edit_command(command)


def run(command: str, cfg: dict) -> int:
    shell = user_shell(cfg)
    note(f"{DIM}--- running ---{RESET}")
    try:
        return subprocess.call(shell_argv(shell, command))
    except KeyboardInterrupt:
        return 130
    except OSError as exc:
        die(f"could not run the command with {shell}: {exc}")
        return 1


