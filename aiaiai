CLAUDE_CODE_PRESET = "claude-code"

PRESETS = [
    ("OpenAI", "https://api.openai.com/v1", "gpt-4o-mini", True),
    ("Claude Code (the claude CLI and its login, no api key here)",
     CLAUDE_CODE_PRESET, CLAUDE_DEFAULT_MODEL, False),
    ("Ollama (running on this machine)", "http://localhost:11434/v1", "llama3.2", False),
    ("LM Studio (running on this machine)", "http://localhost:1234/v1", "local-model", False),
    ("Something else (your own gateway, a server on your network)", None, None, False),
]


def mask(secret: str) -> str:
    """sk-proj-abc...wxyz - enough to recognise, not enough to shoulder-surf."""
    if len(secret) <= 8:
        return "*" * len(secret)
    return f"{secret[:6]}...{secret[-4:]}"


def prompt(question: str, default: str = "", show: str | None = None) -> str:
    shown = show if show is not None else default
    suffix = f" [{shown}]" if shown else ""
    try:
        return input(f"{question}{suffix}: ").strip() or default
    except (EOFError, KeyboardInterrupt):
        note("\nsetup cancelled")
        raise SystemExit(130)


def prompt_yes_no(question: str, default: bool = True) -> bool:
    answer = prompt(f"{question} [{'Y/n' if default else 'y/N'}]").lower()
    if not answer:
        return default
    return answer in ("y", "yes")


def prompt_choice(question: str, options: list[str], default: int = 1) -> int:
    note(f"\n{BOLD}{question}{RESET}")
    for i, label in enumerate(options, 1):
        note(f"  {i}) {label}")
    while True:
        raw = prompt("choose", str(default))
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return int(raw)
        note(f"{YELLOW}pick a number between 1 and {len(options)}{RESET}")


def test_connection(cfg: dict) -> bool:
    if cfg.get("provider") == "claude-code":
        try:
            with Thinking(f"asking Claude Code ({cfg.get('model') or 'default model'}) "
                          f"to say hello", 60):
                ask_claude_code(cfg, "Reply with the single word: ok", "hello", 60)
            note(f"{GREEN}it works.{RESET}")
            return True
        except ClaudeCodeError as exc:
            note(f"{RED}{exc}{RESET}")
        except TimeoutError:
            note(f"{RED}Claude Code did not answer within 60s{RESET}")
        return False
    payload = {"model": cfg["model"],
               "messages": [{"role": "user", "content": "Reply with the single word: ok"}],
               "max_tokens": 10}
    try:
        with Thinking(f"asking {cfg['model']} to say hello", 30):
            post(cfg, payload, 30)
        note(f"{GREEN}it works.{RESET}")
        return True
    except urllib.error.HTTPError as exc:
        note(f"{RED}the server answered HTTP {exc.code}{RESET}: "
             f"{exc.read().decode(errors='replace')[:200]}")
        if exc.code in (401, 403):
            note("  that usually means the api key is wrong or missing.")
        elif exc.code == 404:
            note("  that usually means the model name or the url is wrong.")
    except (TimeoutError, urllib.error.URLError) as exc:
        note(f"{RED}no answer from {cfg['base_url']}{RESET}: {getattr(exc, 'reason', exc)}")
        note("  is the server running, and is the address right?")
    except Exception as exc:  # noqa: BLE001
        note(f"{RED}unexpected problem{RESET}: {exc}")
    return False


def setup(path: str | None) -> int:
    path = path or CONFIG_PATH
    if not sys.stdin.isatty():
        die(f"--setup needs a terminal. Run '{PROG} --init' and edit {path} instead.")

    cfg = dict(DEFAULTS)
    existing = os.path.exists(path)
    if existing:
        cfg.update({k: v for k, v in load_config(path).items() if not k.startswith("_")})
        cfg["_was_claude"] = normalize_provider(cfg.get("provider")) == "claude-code"
        note(f"{BOLD}aiaiai setup{RESET} - updating {path}")
        note(f"{DIM}press enter to keep the current value{RESET}")
    else:
        note(f"{BOLD}aiaiai setup{RESET} - let's point this at an AI you can use.")

    cfg["provider"] = normalize_provider(cfg.get("provider"))
    current = len(PRESETS) if existing else 1
    if existing and cfg["provider"] == "claude-code":
        current = next(i for i, p in enumerate(PRESETS, 1) if p[1] == CLAUDE_CODE_PRESET)
    choice = prompt_choice("Where should aiaiai send your questions?",
                           [p[0] for p in PRESETS], default=current)
    label, url, model, needs_key = PRESETS[choice - 1]

    cfg["provider"] = "claude-code" if url == CLAUDE_CODE_PRESET else "openai"
    if url == CLAUDE_CODE_PRESET:
        found = shutil.which(cfg.get("claude_bin") or "claude")
        if found:
            note(f"\n{DIM}using {found}{RESET}")
        else:
            note(f"\n{YELLOW}the claude command is not on your PATH yet.{RESET} "
                 f"Install it from https://code.claude.com/docs and log in once.")
        note(f"{DIM}haiku is quick and plenty for one command; sonnet or opus "
             f"think harder{RESET}")
        keep = cfg["model"] if existing and cfg.get("_was_claude") else model
        cfg["model"] = prompt("model name", keep)
    elif url is None:
        note(f"\n{DIM}the base url of any OpenAI-compatible API, "
             f"e.g. https://example.com/v1{RESET}")
        cfg["base_url"] = prompt("base url", cfg["base_url"])
        # a Claude Code model name means nothing to an OpenAI-style server
        cfg["model"] = prompt("model name",
                              DEFAULTS["model"] if cfg.get("_was_claude") else cfg["model"])
        cfg["api_key"] = prompt("api key (blank if the server needs none)", "") or "not-required"
    else:
        cfg["base_url"] = url
        note(f"\n{DIM}using {url}{RESET}")
        cfg["model"] = prompt("model name", model)
        if needs_key:
            note(f"{DIM}from https://platform.openai.com/api-keys - stored in {path}, "
                 f"readable only by you{RESET}")
            while True:
                current = cfg.get("api_key", "") if existing else ""
                key = prompt("api key", current, show=mask(current) if current else "")
                if key and key != "not-required":
                    cfg["api_key"] = key
                    break
                note(f"{YELLOW}{label} needs a key to answer anything{RESET}")
        else:
            cfg["api_key"] = "not-required"

    mode_choice = prompt_choice(
        "What should aiaiai do with the command it comes up with?",
        ["show it and ask before running       (confirm - safest)",
         "print only the command, run nothing  (command)",
         "print it with a short explanation    (explain)",
         "just run it, no questions            (auto)"],
        default={"confirm": 1, "command": 2, "explain": 3, "auto": 4}.get(cfg.get("mode"), 1),
    )
    cfg["mode"] = ("confirm", "command", "explain", "auto")[mode_choice - 1]
    note(f"{DIM}override it per call with -c, -e, -r, -y{RESET}")

    save_config(path, cfg)

    note()
    if prompt_yes_no("test the connection now?"):
        if not test_connection(cfg):
            note(f"\n{YELLOW}setup saved anyway.{RESET} Fix the details with "
                 f"'{PROG} --setup', or edit {path}.")
            return 1

    note(f"\n{GREEN}ready.{RESET} Try it:")
    note(f"  {BOLD}{PROG} how do I find the biggest files in this folder{RESET}")
    return 0


# --------------------------------------------------------------------- main

USAGE = f"""{PROG} {VERSION} - ask your LLM for the command you meant to type

usage:
  {PROG} <what you want to do>
  {PROG} -r find every file bigger than 1G under /var

output modes (the default comes from the config file):
  -c, --command      print only the command
  -e, --explain      print the command and a short explanation
  -r, --run          print it and ask before running
  -y, --yes, --auto  run it without asking

other options:
  -m, --model NAME   override the model for this call
      --url URL      override the OpenAI-compatible base url
      --claude       ask Claude Code (claude -p) for this call
      --provider P   openai or claude-code, for this call
      --timeout SECS override how long to wait for an answer
      --config PATH  use a different config file
      --no-context   do not send the directory listing or the tool list
      --force        skip the extra prompt on dangerous commands (with --yes)
      --setup        interactive configuration, re-runnable any time
      --init         write a default config to {CONFIG_PATH}
      --where        print the config path in use
  -h, --help         this text
  -V, --version      version

the command goes to stdout and everything else to stderr, so this works:
  mkdir -p out && $({PROG} -c list every png here)

aiaiai is free software under the AGPL-3.0-or-later.
"""


def main(argv: list[str]) -> int:
    opts = {"mode": None, "config": None, "model": None, "url": None,
            "timeout": None, "no_context": False, "force": False, "provider": None}
    words: list[str] = []

    args = list(argv)

    def value(name: str) -> str:
        if not args:
            die(f"{name} needs a value")
        return args.pop(0)

    while args:
        arg = args.pop(0)
        if words and not arg.startswith("--"):
            words.append(arg)
            continue
        if arg == "--":
            words.extend(args)
            break
        elif arg in ("-h", "--help"):
            note(USAGE)
            return 0
        elif arg in ("-V", "--version"):
            print(VERSION)
            return 0
        elif arg == "--where":
            print(opts["config"] or CONFIG_PATH)
            return 0
        elif arg == "--init":
            path = opts["config"] or CONFIG_PATH
            if os.path.exists(path):
                die(f"{path} already exists, leaving it alone (try: {PROG} --setup)")
            save_config(path, dict(DEFAULTS))
            return 0
        elif arg in ("--setup", "--configure"):
            return setup(opts["config"])
        elif arg in ("-c", "--command"):
            opts["mode"] = "command"
        elif arg in ("-e", "--explain"):
            opts["mode"] = "explain"
        elif arg in ("-r", "--run", "--confirm"):
            opts["mode"] = "confirm"
        elif arg in ("-y", "--yes", "--auto"):
            opts["mode"] = "auto"
        elif arg in ("-m", "--model"):
            opts["model"] = value(arg)
        elif arg == "--url":
            opts["url"] = value(arg)
        elif arg == "--claude":
            opts["provider"] = "claude-code"
        elif arg == "--provider":
            opts["provider"] = value(arg)
        elif arg == "--timeout":
            opts["timeout"] = value(arg)
        elif arg == "--config":
            opts["config"] = value(arg)
        elif arg == "--no-context":
            opts["no_context"] = True
        elif arg == "--force":
            opts["force"] = True
        elif arg.startswith("-") and len(arg) > 1 and not words:
            die(f"unknown option {arg}\n  (put -- first if your request starts with a dash)")
        else:
            words.append(arg)

    question = " ".join(words).strip()
    if not question:
        note(USAGE)
        return 2

    cfg = load_config(opts["config"])
    if opts["url"] and not opts["provider"]:
        opts["provider"] = "openai"  # a url only means something to an OpenAI-style API
    if opts["provider"]:
        switching = normalize_provider(opts["provider"]) != normalize_provider(cfg["provider"])
        cfg["provider"] = opts["provider"]
        if switching:
            cfg["_model_set"] = False  # the configured model belongs to the other provider
    if opts["model"]:
        cfg["model"] = opts["model"]
        cfg["_model_set"] = True
    if opts["url"]:
        cfg["base_url"] = opts["url"]
    settle_provider(cfg)
    if opts["timeout"]:
        try:
            cfg["timeout"] = float(opts["timeout"])
        except ValueError:
            die(f"--timeout wants a number of seconds, not {opts['timeout']!r}")
    if opts["no_context"]:
        cfg["context"] = cfg["tools"] = False

    mode = opts["mode"] or cfg.get("mode", "confirm")
    if mode not in MODES:
        die(f"unknown mode {mode!r} - expected one of {', '.join(MODES)}")

    piped = read_piped_stdin()
    if piped:
        question = f"{question}\n\nInput piped to {PROG}:\n{piped[:4000]}"

    answer = ask(cfg, question, gather_context(cfg, referenced_paths(question)))
    command, explanation = answer["command"], answer["explanation"]
    if not command:
        die(explanation or "the model did not come up with a command")

    risk = danger(command)

    if mode == "command":
        print(command)
        return 0
    if mode == "explain":
        print(command)
        if explanation:
            note(f"{DIM}{explanation}{RESET}")
        if risk:
            note(f"{RED}careful:{RESET} {risk}")
        return 0

    note(f"{BOLD}{command}{RESET}")
    if explanation:
        note(f"{DIM}{explanation}{RESET}")

    if mode == "auto" and (not risk or opts["force"]):
        return run(command, cfg)
    if mode == "auto" and risk:
        note(f"{RED}careful:{RESET} {risk} - asking anyway (--force skips this)")

    chosen = confirm_command(command, risk)
    if chosen is None:
        note("aborted")
        return 130
    return run(chosen, cfg)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
