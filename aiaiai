def toml_str(value) -> str:
    """Quote a value for TOML. Only the types this config actually holds."""
    if isinstance(value, list):
        return "[" + ", ".join(toml_str(v) for v in value) + "]"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    escaped = str(value).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def render_config(cfg: dict) -> str:
    fields = ("base_url", "model", "api_key", "mode", "shell", "context",
              "max_context_entries", "tools", "extra_tools", "temperature", "timeout")
    return CONFIG_TEMPLATE.format(**{k: toml_str(cfg.get(k, DEFAULTS[k])) for k in fields})


