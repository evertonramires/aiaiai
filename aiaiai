PRESETS = [
    ("OpenAI", "https://api.openai.com/v1", "gpt-4o-mini", True),
    ("Ollama (running on this machine)", "http://localhost:11434/v1", "llama3.2", False),
    ("LM Studio (running on this machine)", "http://localhost:1234/v1", "local-model", False),
