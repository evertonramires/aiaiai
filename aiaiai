def prompt(question: str, default: str = "") -> str:
    suffix = f" [{default}]" if default else ""
    try:
        answer = input(f"{question}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        note("\nsetup cancelled")
        raise SystemExit(130)
    return answer or default


def prompt_yes_no(question: str, default: bool = True) -> bool:
    hint = "Y/n" if default else "y/N"
    try:
        answer = input(f"{question} [{hint}]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        note("")
        return False
    if not answer:
        return default
    return answer in ("y", "yes")


def prompt_choice(question: str, options: list, default: int = 1) -> int:
    note(f"\n{BOLD}{question}{RESET}")
    for i, label in enumerate(options, 1):
        note(f"  {i}) {label}")
    while True:
        raw = prompt("choose", str(default))
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return int(raw)
        note(f"{YELLOW}pick a number between 1 and {len(options)}{RESET}")


def test_connection(cfg: dict) -> bool:
    note(f"{DIM}asking {cfg['model']} to say hello...{RESET}")
    payload = {
        "model": cfg["model"],
        "messages": [{"role": "user", "content": "Reply with the single word: ok"}],
        "max_tokens": 10,
    }
    req = urllib.request.Request(
        endpoint(cfg["base_url"]),
        data=json.dumps(payload).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {cfg.get('api_key') or 'not-required'}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            json.loads(resp.read().decode())
        note(f"{GREEN}it works.{RESET}")
        return True
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")[:200]
        note(f"{RED}the server answered HTTP {exc.code}{RESET}: {detail}")
        if exc.code in (401, 403):
            note("  that usually means the API key is wrong or missing.")
        elif exc.code == 404:
            note("  that usually means the model name or the url is wrong.")
    except urllib.error.URLError as exc:
        note(f"{RED}could not reach {cfg['base_url']}{RESET}: {exc.reason}")
        note("  is the server running, and is the address right?")
    except Exception as exc:  # noqa: BLE001
        note(f"{RED}unexpected problem{RESET}: {exc}")
    return False


def setup(path: str | None) -> int:
    path = path or CONFIG_PATH
    if not sys.stdin.isatty():
        die(f"--setup needs a terminal. Run '{PROG} --init' and edit {path} instead.")

    cfg = dict(DEFAULTS)
    existing = os.path.exists(path)
    if existing:
        cfg.update({k: v for k, v in load_config(path).items() if not k.startswith("_")})
        note(f"{BOLD}aiaiai setup{RESET} - updating {path}")
        note(f"{DIM}press enter to keep the current value{RESET}")
    else:
        note(f"{BOLD}aiaiai setup{RESET} - let's point this at an AI you can use.")

    choice = prompt_choice(
        "Where should aiaiai send your questions?",
        [p[0] for p in PRESETS],
        default=4 if existing else 1,
    )
    label, url, model, needs_key = PRESETS[choice - 1]

    if url is None:
        note(f"\n{DIM}the base url of any OpenAI-compatible API, e.g. "
             f"https://example.com/v1{RESET}")
        cfg["base_url"] = prompt("base url", cfg["base_url"])
        cfg["model"] = prompt("model name", cfg["model"])
        key = prompt("api key (leave blank if the server does not need one)", "")
        cfg["api_key"] = key or "not-required"
    else:
        cfg["base_url"] = url
        note(f"\n{DIM}using {url}{RESET}")
        cfg["model"] = prompt("model name", model)
        if needs_key:
            note(f"{DIM}from https://platform.openai.com/api-keys - stored in {path}, "
                 f"readable only by you{RESET}")
            while True:
                key = prompt("api key", "" if not existing else cfg.get("api_key", ""))
                if key and key != "not-required":
                    cfg["api_key"] = key
                    break
                note(f"{YELLOW}{label} needs a key to answer anything{RESET}")
        else:
            cfg["api_key"] = "not-required"

    mode_choice = prompt_choice(
        "What should aiaiai do with the command it comes up with?",
        [
            "show it and ask before running       (confirm - safest)",
            "print only the command, run nothing  (command)",
            "print it with a short explanation    (explain)",
            "just run it, no questions            (auto)",
        ],
        default={"confirm": 1, "command": 2, "explain": 3, "auto": 4}.get(cfg.get("mode"), 1),
    )
    cfg["mode"] = ("confirm", "command", "explain", "auto")[mode_choice - 1]
    note(f"{DIM}you can override this per call with -c, -e, -r, -y{RESET}")

    save_config(path, cfg)

    note("")
    if prompt_yes_no("test the connection now?"):
        if not test_connection(cfg):
            note(f"\n{YELLOW}setup saved anyway.{RESET} Fix the details with "
                 f"'{PROG} --setup', or edit {path}.")
            return 1

    note(f"\n{GREEN}ready.{RESET} Try it:")
    note(f"  {BOLD}{PROG} how do I find the biggest files in this folder{RESET}")
    return 0


# ------------------------------------------------------------------------- api

def endpoint(base_url: str) -> str:
    base = base_url.rstrip("/")
    if not base.endswith("/v1"):
        base += "/v1"
    return base + "/chat/completions"


def ask(cfg: dict, question: str, context: str) -> dict:
    payload = {
        "model": cfg["model"],
        "temperature": float(cfg.get("temperature", 0.2)),
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": f"Context:\n{context}\n\nRequest: {question}"},
        ],
    }
    req = urllib.request.Request(
        endpoint(cfg["base_url"]),
        data=json.dumps(payload).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {cfg.get('api_key') or 'not-required'}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=float(cfg.get("timeout", 120))) as resp:
            body = json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")[:400]
        die(f"{cfg['base_url']} returned HTTP {exc.code}: {detail}")
    except urllib.error.URLError as exc:
        if not cfg.get("_configured"):
            die(f"cannot reach {cfg['base_url']}: {exc.reason}\n"
                f"  no config file yet - run '{PROG} --setup' to point aiaiai "
                f"at an AI you can use.")
        die(f"cannot reach {cfg['base_url']}: {exc.reason}")
    except TimeoutError:
        die("the model took too long to answer")

    try:
        content = body["choices"][0]["message"]["content"]
    except (KeyError, IndexError):
        die(f"unexpected response: {json.dumps(body)[:400]}")
    return parse_answer(content)


def parse_answer(content: str) -> dict:
    text = (content or "").strip()
    # Qwen-style reasoning preamble
    text = re.sub(r"^<think>.*?</think>", "", text, flags=re.S).strip()
    fence = re.search(r"```(?:json|sh|bash)?\s*(.*?)```", text, flags=re.S)
    if fence:
        text = fence.group(1).strip()

    obj = None
    try:
        obj = json.loads(text)
    except json.JSONDecodeError:
        brace = re.search(r"\{.*\}", text, flags=re.S)
        if brace:
            try:
                obj = json.loads(brace.group(0))
            except json.JSONDecodeError:
                obj = None

    if isinstance(obj, dict):
        command = str(obj.get("command") or "").strip()
        explanation = str(obj.get("explanation") or "").strip()
    else:
        # Model ignored the format; treat the first non-empty line as the command.
        lines = [ln for ln in text.splitlines() if ln.strip()]
        command = lines[0].strip() if lines else ""
        explanation = " ".join(ln.strip() for ln in lines[1:]).strip()

    command = command.strip("`").strip()
    if command.startswith("$ "):
        command = command[2:]
    return {"command": command, "explanation": explanation}


# ------------------------------------------------------------------- execution

def danger(command: str) -> str | None:
    for pattern, why in DANGEROUS:
        if re.search(pattern, command, flags=re.I):
            return why
    return None


def prompt_user(command: str, risk: str | None) -> str | None:
    """Returns the command to run, or None to abort."""
    if not sys.stdin.isatty():
        note(f"{YELLOW}not a tty, refusing to run without confirmation{RESET}")
        return None
    while True:
        hint = f"{RED}[{risk}]{RESET} " if risk else ""
        try:
            answer = input(f"{hint}run it? [y/N/e(dit)] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            note("")
            return None
        if answer in ("y", "yes"):
            return command
        if answer in ("", "n", "no", "q"):
            return None
        if answer in ("e", "edit"):
            edited = edit_command(command)
            if edited:
                return edited
            return None


def edit_command(command: str) -> str | None:
    try:
        import readline
        readline.set_startup_hook(lambda: readline.insert_text(command))
        try:
            return input("> ").strip() or None
        finally:
            readline.set_startup_hook()
    except (ImportError, EOFError, KeyboardInterrupt):
        note("")
        return None


def run(command: str, cfg: dict) -> int:
    shell = user_shell(cfg)
    note(f"{DIM}--- running ---{RESET}")
    try:
        return subprocess.call([shell, "-c", command])
    except KeyboardInterrupt:
        return 130
    except OSError as exc:
        die(f"could not run with {shell}: {exc}")
        return 1


# ------------------------------------------------------------------------ main

USAGE = f"""{PROG} {VERSION} - ask your LLM for the command you meant to type

usage:
  {PROG} <what you want to do>
  {PROG} -r find every file bigger than 1G under /var

output modes (default comes from the config file):
  -c, --command      print only the command
  -e, --explain      print the command and a short explanation
  -r, --run          print it and ask before running
  -y, --yes, --auto  run it without asking

other options:
  -m, --model NAME   override the model for this call
      --url URL      override the OpenAI-compatible base url
      --config PATH  use a different config file
      --no-context   do not send the directory listing or the tool list
      --force        skip the extra prompt on dangerous commands (with --yes)
      --setup        interactive first-time configuration
      --init         write an example config to {CONFIG_PATH}
      --where        print the config path in use
  -h, --help         this text
  -V, --version      version

the command goes to stdout, everything else to stderr, so this works:
  mkdir -p out && $({PROG} -c list every png here)
"""


def main(argv: list[str]) -> int:
    mode_override = None
    config_path = None
    model = url = None
    no_context = False
    force = False
    words: list[str] = []

    args = list(argv)
    while args:
        arg = args.pop(0)
        if words and not arg.startswith("--"):
            words.append(arg)
            continue
        if arg == "--":
            words.extend(args)
            break
        elif arg in ("-h", "--help"):
            print(USAGE, file=sys.stderr)
            return 0
        elif arg in ("-V", "--version"):
            print(VERSION)
            return 0
        elif arg == "--init":
            write_example_config(config_path or CONFIG_PATH)
            return 0
        elif arg in ("--setup", "--configure"):
            return setup(config_path)
        elif arg == "--where":
            print(config_path or CONFIG_PATH)
            return 0
        elif arg in ("-c", "--command"):
            mode_override = "command"
        elif arg in ("-e", "--explain"):
            mode_override = "explain"
        elif arg in ("-r", "--run", "--confirm"):
            mode_override = "confirm"
        elif arg in ("-y", "--yes", "--auto"):
            mode_override = "auto"
        elif arg in ("-m", "--model"):
            model = args.pop(0) if args else die("--model needs a value")
        elif arg == "--url":
            url = args.pop(0) if args else die("--url needs a value")
        elif arg == "--config":
            config_path = args.pop(0) if args else die("--config needs a value")
        elif arg == "--no-context":
            no_context = True
        elif arg == "--force":
            force = True
        elif arg.startswith("-") and len(arg) > 1 and not words:
            die(f"unknown option {arg} (use -- before a request starting with a dash)")
        else:
            words.append(arg)

    question = " ".join(words).strip()
    if not question:
        print(USAGE, file=sys.stderr)
        return 2

    cfg = load_config(config_path)
    if model:
        cfg["model"] = model
    if url:
        cfg["base_url"] = url
    if no_context:
        cfg["context"] = False
        cfg["tools"] = False

    mode = mode_override or cfg.get("mode", "confirm")
    if mode not in MODES:
        die(f"unknown mode {mode!r}, expected one of {', '.join(MODES)}")

    piped = read_piped_stdin()
    if piped:
        question = f"{question}\n\nInput piped to {PROG}:\n{piped[:4000]}"

    context = gather_context(cfg, referenced_paths(question))
    answer = ask(cfg, question, context)
    command = answer["command"]
    explanation = answer["explanation"]

    if not command:
        die(explanation or "the model did not produce a command")

    risk = danger(command)

    if mode == "command":
        print(command)
        return 0

    if mode == "explain":
        print(command)
        if explanation:
            note(f"{DIM}{explanation}{RESET}")
        if risk:
            note(f"{RED}careful:{RESET} {risk}")
        return 0

    note(f"{BOLD}{command}{RESET}")
    if explanation:
        note(f"{DIM}{explanation}{RESET}")

    if mode == "auto" and (not risk or force):
        return run(command, cfg)

    if mode == "auto" and risk:
        note(f"{RED}careful:{RESET} {risk} - asking anyway (use --force to skip)")

    chosen = prompt_user(command, risk)
    if chosen is None:
        note("aborted")
        return 130
    return run(chosen, cfg)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
